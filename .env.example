# =====================================================================
# Wings King POS — plantilla de .env
# Copiar a .env y llenar los valores:   cp .env.example .env
# Después:   php artisan key:generate   y   php artisan config:clear
# Valores marcados [PROD] son los recomendados para producción.
# Nunca subir el .env real a git (está en .gitignore).
# =====================================================================

# ---------- Aplicación ----------
APP_NAME="Wings King"
# [PROD] production
APP_ENV=local
# Se genera con: php artisan key:generate (no copiar la de otro equipo)
APP_KEY=
# [PROD] false — en true muestra errores con rutas y datos de la base
APP_DEBUG=true
# URL con la que se entra al sistema (el agente de WhatsApp llama a esta misma base + /api/agente/...)
APP_URL=http://localhost

# Zona horaria. PHP 7.4 trae una tzdb de 2021 que todavía aplica horario de verano a
# America/Mexico_City (abolido en 2022) y los tickets salen con +1 h. America/Regina es -06:00 fijo.
# Si se actualiza PHP (tzdb >= 2022), se puede volver a America/Mexico_City.
APP_TIMEZONE=America/Regina

LOG_CHANNEL=stack

# ---------- Base de datos (MySQL, tablas InnoDB) ----------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wingskings
DB_USERNAME=
DB_PASSWORD=
# Las pruebas (vendor/bin/phpunit) usan la base wingskings_test, definida en phpunit.xml.

# ---------- Sesión, caché y colas ----------
# Con la bandeja abierta la sesión no expira (el refresco automático la mantiene viva).
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
# log mientras no haya websockets; pusher cuando se instale laravel-websockets (ver BANDEJA_WEBSOCKETS)
BROADCAST_DRIVER=log

# ---------- Agente de WhatsApp ----------
# Token que el agente manda en el encabezado X-Agente-Token para imprimir órdenes
# (POST /api/agente/ventas/{folio}/imprimir-orden). Vacío = se rechaza todo.
# Debe ser igual al configurado en el agente. Generar uno largo y aleatorio, p. ej.:
#   php -r "echo bin2hex(random_bytes(32));"
AGENTE_TOKEN=

# ---------- Bandeja de comandas en tiempo real (docs/plan-bandeja-tiempo-real.md) ----------
# Segundos entre consultas de la bandeja (mínimo 2).
BANDEJA_INTERVALO=5
# true solo cuando laravel-websockets esté instalado y corriendo. Mientras el socket esté
# conectado, la consulta baja a BANDEJA_INTERVALO_RESPALDO; si se cae, vuelve sola a BANDEJA_INTERVALO.
BANDEJA_WEBSOCKETS=false
BANDEJA_INTERVALO_RESPALDO=60

# ---------- Websockets (todavía no se usan) ----------
# Se llenan al instalar beyondcode/laravel-websockets (servidor propio, no la nube de Pusher).
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

# ---------- Correo (opcional; el POS no manda correos hoy) ----------
MAIL_DRIVER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls

# ---------- Redis (opcional; no se usa con los drivers de arriba) ----------
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
